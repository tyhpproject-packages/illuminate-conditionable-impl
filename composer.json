{
    "name": "tyhpdef/illuminate-conditionable-impl",
    "description": "Implementation package for tyhpdef/illuminate-conditionable. Require tyhpdef/illuminate-conditionable, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "13.32.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/illuminate-conditionable"
        }
    },
    "require": {
        "php": ">=8.2",
        "illuminate/conditionable": "13.32.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev"
    }
}
